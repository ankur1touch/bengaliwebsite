# CMS Football Proxy base URL (no trailing slash on domain path)
FOOTBALL_API_BASE_URL=https://api.labenditaec.com/api/football

# Season year for player/team/fixture endpoints
FOOTBALL_API_SEASON=2025

# Football-Data.org optional fallback — https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Your deployed site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://footballbarta.vercel.app

# CMS publish API (n8n → Football Barta)
CMS_API_TOKEN=your-secret-token-here

# MongoDB for published CMS articles (required on Vercel; optional locally — falls back to MDX files)
MONGODB_URI=
MONGODB_DB=football_barta
